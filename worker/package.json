{
  "name": "whitelist-worker",
  "private": true,
  "type": "module",
  "description": "Cloudflare half of the whitelist gateway: public form + API + D1",
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply whitelist --remote",
    "migrate:local": "wrangler d1 migrations apply whitelist --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
